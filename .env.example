# ---------------------------------------------------------------------------
# Telegram MTProto — ваш ПОЛЬЗОВАТЕЛЬСКИЙ аккаунт (чтение сообщений)
# Получить на https://my.telegram.org -> API development tools
# ---------------------------------------------------------------------------
API_ID=123456
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Имя session-файла. Файл появится рядом с проектом: telegram_filter.session
SESSION_NAME=telegram_filter
# Необязательно: каталог для session-файла (по умолчанию — корень проекта)
# SESSION_DIR=/opt/telegram-filter

# ---------------------------------------------------------------------------
# Источник — бот, сообщения которого нужно фильтровать
# Можно указать @username или числовой id
# ---------------------------------------------------------------------------
SOURCE_BOT_USERNAME=@example_bot

# ---------------------------------------------------------------------------
# Telegram Bot API — ВАШ бот (отправка отфильтрованных сообщений)
# Токен берётся у @BotFather, chat_id — см. README
# ---------------------------------------------------------------------------
TARGET_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TARGET_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# Фильтр
# ---------------------------------------------------------------------------
# Разрешающие слова через запятую. Совпадение хотя бы одного -> сообщение проходит.
# Если оставить пустым и не задать FILTER_REGEX — проходят все сообщения.
FILTER_KEYWORDS=важно,критично,ошибка,авария

# Запрещённые слова. Имеют высший приоритет: если найдено — сообщение отбрасывается,
# даже когда в нём есть разрешённое слово.
FILTER_EXCLUDE_KEYWORDS=реклама,акция,подпишись

# Необязательный regex (Python re). Срабатывает по ИЛИ с FILTER_KEYWORDS.
# Пример: FILTER_REGEX=CPU\s+>\s*9\d%
FILTER_REGEX=

# false -> "КРИТИЧНО" совпадёт с "критично"
CASE_SENSITIVE=false

# Ограничения длины текста (0 = без ограничения)
FILTER_MIN_LENGTH=0
FILTER_MAX_LENGTH=0

# ---------------------------------------------------------------------------
# Самопроверка при старте (тестовый режим)
# ---------------------------------------------------------------------------
# true  -> при запуске сервис находит последнее совпадение в истории источника
#          и присылает его в целевой чат: сразу видно, что связка
#          аккаунт -> источник -> фильтр -> бот настроена верно.
# false -> при запуске ничего не отправлять (обычный рабочий режим).
# Историю это не «съедает»: сообщение не помечается обработанным.
STARTUP_PROBE=true

# Сколько последних сообщений источника просмотреть в поисках совпадения.
STARTUP_PROBE_LIMIT=50

# ---------------------------------------------------------------------------
# Команды бота
# ---------------------------------------------------------------------------
# true  -> бот принимает команды (/info, /keywords, /add, /approve …).
#          Для этого сервис опрашивает getUpdates — постоянный long polling.
#          Посторонним доступен только /start (заявка на доступ).
# false -> getUpdates не опрашивается, бот работает в режиме «только отправка»,
#          и одобрять заявки становится нечем.
BOT_COMMANDS=true

# ---------------------------------------------------------------------------
# Многопользовательский режим
# ---------------------------------------------------------------------------
# Администратор по умолчанию — ВЛАДЕЛЕЦ Telethon-сессии, то есть тот аккаунт,
# чьи API_ID/API_HASH указаны выше. Его id определяется при старте сам, в .env
# его писать не нужно: сообщения приходят именно ему, ему и решать, кому их
# пересылать.
#
# ADMIN_IDS нужен только для ДОПОЛНИТЕЛЬНЫХ администраторов. Важно: бот не
# может написать первым, поэтому каждый такой человек должен сам один раз
# нажать Start у бота — иначе уведомления о заявках до него не дойдут.
# ADMIN_IDS=111111111,222222222

# true  -> одобренные пользователи настраивают свои правила командами бота
#          и получают совпадения в личку.
# false -> прежнее поведение: только TARGET_CHAT_ID и фильтр из FILTER_*.
MULTI_USER=true

# true  -> FILTER_* ниже по-прежнему работает и шлёт в TARGET_CHAT_ID.
#          У новых пользователей правила СВОИ и изначально пустые:
#          пока человек не добавит слово через /add, ему ничего не приходит.
# false -> в TARGET_CHAT_ID ничего не шлём, только персональные рассылки.
LEGACY_DELIVERY=true

# Предохранитель: сколько ключевых слов разрешено одному пользователю.
MAX_KEYWORDS_PER_USER=50

# ---------------------------------------------------------------------------
# Хранилище: журнал доставок, пользователи и их правила
# ---------------------------------------------------------------------------
# DB_PATH=/opt/telegram-filter/processed_messages.db
DB_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Логирование
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# true -> писать полный текст сообщений (только для отладки, уровень DEBUG)
LOG_MESSAGE_TEXT=false

# ---------------------------------------------------------------------------
# Сеть и устойчивость
# ---------------------------------------------------------------------------
# Максимум секунд ожидания при FloodWait; дольше — отказ вместо бесконечных попыток
FLOOD_WAIT_MAX_SECONDS=900
BOT_API_TIMEOUT=20
BOT_API_MAX_RETRIES=4
RECONNECT_MAX_DELAY=60
